+// ── int8 mat-mul for weight x activation products (opt-in: LOCALVQE_INT8=1) ──
+// Weights are quantized once per output row (symmetric, round half away from
+// zero) and cached by tensor; each activation column is quantized per call the
+// same way. Products accumulate exactly in int32 and are scaled back with
+// scalar float math, so the NEON and scalar versions give the same bits on
+// every platform (a host run computes what a device runs). K is padded to a
+// multiple of 16 with zeros, rows to a multiple of 4.
+typedef struct {
+    const void * data; int64_t ne0, ne1, nb1;
+    int K16, M4;
+    int8_t * q;      // M4 x K16
+    float * s;       // M4 row scales
+    atomic_int ready;
+} ks_q8_weight;
+#define KS_Q8_MAX 512
+static ks_q8_weight ks_q8_cache[KS_Q8_MAX];
+static atomic_int ks_q8_count;
+
+static int ks_int8_enabled(void) {
+    static int v = -1;
+    if (v < 0) { const char * e = getenv("LOCALVQE_INT8"); v = (e && e[0] == '1') ? 1 : 0; }
+    return v;
+}
+
+static inline int8_t ks_q8_round(float t) {
+    t += (t >= 0.0f) ? 0.5f : -0.5f;
+    int q = (int) t;
+    return (int8_t) (q > 127 ? 127 : (q < -127 ? -127 : q));
+}
+
+// quantize n floats (zero-padded to n16) with a symmetric scale; returns the scale
+static float ks_q8_vec(const float * x, int n, int n16, int8_t * q) {
+    float m = 0.0f;
+    int j = 0;
+#if defined(__ARM_NEON)
+    // the maximum is exact in any order, so the vector scan gives the scalar result
+    if (n >= 8) {
+        float32x4_t m0 = vdupq_n_f32(0.0f), m1 = m0;
+        for (; j + 8 <= n; j += 8) {
+            m0 = vmaxq_f32(m0, vabsq_f32(vld1q_f32(x + j)));
+            m1 = vmaxq_f32(m1, vabsq_f32(vld1q_f32(x + j + 4)));
+        }
+        m0 = vmaxq_f32(m0, m1);
+        m = fmaxf(fmaxf(vgetq_lane_f32(m0, 0), vgetq_lane_f32(m0, 1)), fmaxf(vgetq_lane_f32(m0, 2), vgetq_lane_f32(m0, 3)));
+    }
+#endif
+    for (; j < n; j++) { const float a = fabsf(x[j]); if (a > m) m = a; }
+    if (m == 0.0f) { memset(q, 0, (size_t)n16); return 0.0f; }
+    const float inv = 127.0f / m;
+    int i = 0;
+#if defined(__ARM_NEON)
+    const float32x4_t vinv = vdupq_n_f32(inv), half = vdupq_n_f32(0.5f);
+    const uint32x4_t sign = vdupq_n_u32(0x80000000u);
+    for (; i + 8 <= n; i += 8) {
+        float32x4_t t0 = vmulq_f32(vld1q_f32(x + i), vinv), t1 = vmulq_f32(vld1q_f32(x + i + 4), vinv);
+        // t + copysign(0.5, t), then truncate; same as ks_q8_round (|t| <= 127.5)
+        t0 = vaddq_f32(t0, vreinterpretq_f32_u32(vorrq_u32(vreinterpretq_u32_f32(half), vandq_u32(vreinterpretq_u32_f32(t0), sign))));
+        t1 = vaddq_f32(t1, vreinterpretq_f32_u32(vorrq_u32(vreinterpretq_u32_f32(half), vandq_u32(vreinterpretq_u32_f32(t1), sign))));
+        int32x4_t q0 = vcvtq_s32_f32(t0), q1 = vcvtq_s32_f32(t1);
+        q0 = vmaxq_s32(vminq_s32(q0, vdupq_n_s32(127)), vdupq_n_s32(-127));
+        q1 = vmaxq_s32(vminq_s32(q1, vdupq_n_s32(127)), vdupq_n_s32(-127));
+        vst1_s8(q + i, vmovn_s16(vcombine_s16(vmovn_s32(q0), vmovn_s32(q1))));
+    }
+#endif
+    for (; i < n; i++) q[i] = ks_q8_round(x[i] * inv);
+    for (; i < n16; i++) q[i] = 0;
+    return m / 127.0f;
+}
+
+static ks_q8_weight * ks_q8_get(const struct ggml_tensor * w) {
+    // find or create (first creator quantizes, others wait for ready)
+    const int n = atomic_load(&ks_q8_count);
+    for (int i = 0; i < n && i < KS_Q8_MAX; i++) {
+        ks_q8_weight * e = &ks_q8_cache[i];
+        if (e->data == w->data && e->ne0 == w->ne[0] && e->ne1 == w->ne[1] && e->nb1 == (int64_t)w->nb[1]) {
+            while (!atomic_load(&e->ready)) { }
+            return e;
+        }
+    }
+    return NULL;
+}
+
+static ks_q8_weight * ks_q8_make(const struct ggml_tensor * w) {
+    const int i = atomic_fetch_add(&ks_q8_count, 1);
+    if (i >= KS_Q8_MAX) return NULL;
+    ks_q8_weight * e = &ks_q8_cache[i];
+    const int K = (int)w->ne[0], M = (int)w->ne[1];
+    e->K16 = (K + 15) & ~15; e->M4 = (M + 3) & ~3;
+    e->q = (int8_t *) calloc((size_t)e->M4 * e->K16, 1);
+    e->s = (float *) calloc((size_t)e->M4, sizeof(float));
+    for (int r = 0; r < M; r++)
+        e->s[r] = ks_q8_vec((const float *)((const char *)w->data + (size_t)r*w->nb[1]), K, e->K16, e->q + (size_t)r*e->K16);
+    e->ne0 = w->ne[0]; e->ne1 = w->ne[1]; e->nb1 = (int64_t)w->nb[1];
+    e->data = w->data;
+    atomic_store(&e->ready, 1);
+    return e;
+}
+
+#if defined(__ARM_NEON)
+static inline int32_t ks_hsum_s32(int32x4_t v) {
+    return vgetq_lane_s32(v, 0) + vgetq_lane_s32(v, 1) + vgetq_lane_s32(v, 2) + vgetq_lane_s32(v, 3);
+}
+#define KS_Q8_ACC(acc, a, b) acc = vpadalq_s16(acc, vmlal_s8(vmull_s8(vget_low_s8(a), vget_low_s8(b)), vget_high_s8(a), vget_high_s8(b)))
+#endif
+
+// four weight rows x two activation columns, exact int32 dot products
+static void ks_q8_4x2(int K16, const int8_t * x, const int8_t * y0, const int8_t * y1, int32_t * o /*[2][4]*/) {
+#if defined(__ARM_NEON)
+    int32x4_t a00 = vdupq_n_s32(0), a01 = a00, a10 = a00, a11 = a00, a20 = a00, a21 = a00, a30 = a00, a31 = a00;
+    const int8_t * x0 = x, * x1 = x + K16, * x2 = x + 2*K16, * x3 = x + 3*K16;
+    for (int k = 0; k < K16; k += 16) {
+        const int8x16_t b0 = vld1q_s8(y0 + k), b1 = vld1q_s8(y1 + k);
+        int8x16_t v = vld1q_s8(x0 + k); KS_Q8_ACC(a00, v, b0); KS_Q8_ACC(a01, v, b1);
+        v = vld1q_s8(x1 + k);           KS_Q8_ACC(a10, v, b0); KS_Q8_ACC(a11, v, b1);
+        v = vld1q_s8(x2 + k);           KS_Q8_ACC(a20, v, b0); KS_Q8_ACC(a21, v, b1);
+        v = vld1q_s8(x3 + k);           KS_Q8_ACC(a30, v, b0); KS_Q8_ACC(a31, v, b1);
+    }
+    o[0] = ks_hsum_s32(a00); o[1] = ks_hsum_s32(a10); o[2] = ks_hsum_s32(a20); o[3] = ks_hsum_s32(a30);
+    o[4] = ks_hsum_s32(a01); o[5] = ks_hsum_s32(a11); o[6] = ks_hsum_s32(a21); o[7] = ks_hsum_s32(a31);
+#else
+    for (int r = 0; r < 4; r++) {
+        const int8_t * xr = x + (size_t)r*K16;
+        int32_t s0 = 0, s1 = 0;
+        for (int k = 0; k < K16; k++) { s0 += (int32_t)xr[k] * y0[k]; s1 += (int32_t)xr[k] * y1[k]; }
+        o[r] = s0; o[4 + r] = s1;
+    }
+#endif
+}
+
+static bool ks_mul_mat_q8(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    if (!ks_int8_enabled()) return false;
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    const struct ggml_tensor * root = src0; while (root->view_src) root = root->view_src;
+    if (!root->buffer || ggml_backend_buffer_get_usage(root->buffer) != GGML_BACKEND_BUFFER_USAGE_WEIGHTS) return false;
+    GGML_TENSOR_BINARY_OP_LOCALS
+    if (ne02 != 1 || ne03 != 1 || ne12 != 1 || ne13 != 1) return false;
+    if (ne00 < 16 || ne01 < 4 || nb00 != sizeof(float) || nb10 != sizeof(float)) return false;
+    ks_q8_weight * w = ks_q8_get(src0);
+    if (!w) {
+        // the first thread to arrive quantizes; any other waits in ks_q8_get
+        if (params->ith == 0) w = ks_q8_make(src0);
+        else { while (!(w = ks_q8_get(src0))) { if (atomic_load(&ks_q8_count) >= KS_Q8_MAX) return false; } }
+        if (!w) return false;
+    }
+    const int K = (int)ne00, M = (int)ne01, C = (int)ne11, K16 = w->K16;
+    // columns are split across threads; each thread quantizes only its own
+    const int pairs = (C + 1) / 2, per = (pairs + params->nth - 1) / params->nth;
+    const int p0 = params->ith * per, p1 = p0 + per < pairs ? p0 + per : pairs;
+    if (p0 >= p1) return true;
+    int8_t * yq = (int8_t *) alloca((size_t)2 * K16);
+    int32_t o[8];
+    for (int pr = p0; pr < p1; pr++) {
+        const int c0 = 2*pr, c1 = c0 + 1;
+        const float s0 = ks_q8_vec((const float *)((const char *)src1->data + (size_t)c0*nb11), K, K16, yq);
+        float s1 = 0.0f;
+        if (c1 < C) s1 = ks_q8_vec((const float *)((const char *)src1->data + (size_t)c1*nb11), K, K16, yq + K16);
+        else memset(yq + K16, 0, (size_t)K16);
+        float * d0 = (float *)((char *)dst->data + (size_t)c0*nb1);
+        float * d1 = c1 < C ? (float *)((char *)dst->data + (size_t)c1*nb1) : NULL;
+        for (int r = 0; r < M; r += 4) {
+            ks_q8_4x2(K16, w->q + (size_t)r*K16, yq, yq + K16, o);
+            const int nr = M - r < 4 ? M - r : 4;
+            for (int j = 0; j < nr; j++) {
+                const float sc0 = w->s[r + j] * s0;
+                d0[r + j] = (float)o[j] * sc0;
+                if (d1) { const float sc1 = w->s[r + j] * s1; d1[r + j] = (float)o[4 + j] * sc1; }
+            }
+        }
+    }
+    return true;
+}
+
+#if defined(__ARM_NEON) && !defined(__ARM_FEATURE_SVE) && defined(GGML_SIMD)
+// F32 x F32 mat-mul for small contiguous operands. Each output is computed
+// exactly as ggml_vec_dot_f32 computes it (GGML_F32_STEP chunks in
+// GGML_F32_ARR fused accumulators, the same reduction, float leftovers with
+// the fused multiply-add the contracted scalar loop compiles to), so
+// the results are the same bits; what goes away is the per-output call and
+// the per-column 64-bit index division, which dominate when the inner
+// dimension is a few dozen elements (as in the streaming GTCRN graph).
+static inline float ks_dot_vec_part(int np, const float * x, const float * y) {
+    GGML_F32_VEC sum[GGML_F32_ARR] = { GGML_F32_VEC_ZERO };
+    GGML_F32_VEC ax[GGML_F32_ARR];
+    GGML_F32_VEC ay[GGML_F32_ARR];
+    for (int i = 0; i < np; i += GGML_F32_STEP) {
+        for (int j = 0; j < GGML_F32_ARR; j++) {
+            ax[j] = GGML_F32_VEC_LOAD(x + i + j*GGML_F32_EPR);
+            ay[j] = GGML_F32_VEC_LOAD(y + i + j*GGML_F32_EPR);
+            sum[j] = GGML_F32_VEC_FMA(sum[j], ax[j], ay[j]);
+        }
+    }
+    float sumf = 0.0f;
+    GGML_F32_VEC_REDUCE(sumf, sum);
+    return sumf;
+}
+
+// Register-blocked F32 kernel for 32-bit ARM: four src0 rows by two src1
+// columns share their loads, eight vector accumulators. Each output sums its
+// four lanes and then the K % 4 tail, an order that differs from
+// ggml_vec_dot_f32 the way any blocked BLAS does (rounding-level only).
+#if defined(__ARM_NEON) && !defined(__aarch64__) && defined(__ARM_FEATURE_FMA)
+static inline float ks_hsum(float32x4_t v) {
+    return vgetq_lane_f32(v, 0) + vgetq_lane_f32(v, 1) + vgetq_lane_f32(v, 2) + vgetq_lane_f32(v, 3);
+}
+static void ks_gemm_f32_4x2(int K, const float * const * x, const float * y0, const float * y1, float * d0, float * d1) {
+    float32x4_t a00 = vdupq_n_f32(0.0f), a01 = a00, a10 = a00, a11 = a00, a20 = a00, a21 = a00, a30 = a00, a31 = a00;
+    const float * x0 = x[0], * x1 = x[1], * x2 = x[2], * x3 = x[3];
+    int k = 0;
+    // two K steps per iteration so the next step's loads can issue ahead of
+    // this step's multiply-adds (the core is in order); same per-lane order
+    for (; k + 8 <= K; k += 8) {
+        const float32x4_t b0 = vld1q_f32(y0 + k), b1 = vld1q_f32(y1 + k);
+        const float32x4_t v0 = vld1q_f32(x0 + k), v1 = vld1q_f32(x1 + k);
+        const float32x4_t v2 = vld1q_f32(x2 + k), v3 = vld1q_f32(x3 + k);
+        const float32x4_t c0 = vld1q_f32(y0 + k + 4), c1 = vld1q_f32(y1 + k + 4);
+        a00 = vfmaq_f32(a00, v0, b0); a01 = vfmaq_f32(a01, v0, b1);
+        a10 = vfmaq_f32(a10, v1, b0); a11 = vfmaq_f32(a11, v1, b1);
+        const float32x4_t w0 = vld1q_f32(x0 + k + 4), w1 = vld1q_f32(x1 + k + 4);
+        a20 = vfmaq_f32(a20, v2, b0); a21 = vfmaq_f32(a21, v2, b1);
+        a30 = vfmaq_f32(a30, v3, b0); a31 = vfmaq_f32(a31, v3, b1);
+        const float32x4_t w2 = vld1q_f32(x2 + k + 4), w3 = vld1q_f32(x3 + k + 4);
+        a00 = vfmaq_f32(a00, w0, c0); a01 = vfmaq_f32(a01, w0, c1);
+        a10 = vfmaq_f32(a10, w1, c0); a11 = vfmaq_f32(a11, w1, c1);
+        a20 = vfmaq_f32(a20, w2, c0); a21 = vfmaq_f32(a21, w2, c1);
+        a30 = vfmaq_f32(a30, w3, c0); a31 = vfmaq_f32(a31, w3, c1);
+    }
+    for (; k + 4 <= K; k += 4) {
+        const float32x4_t b0 = vld1q_f32(y0 + k), b1 = vld1q_f32(y1 + k);
+        float32x4_t v = vld1q_f32(x0 + k); a00 = vfmaq_f32(a00, v, b0); a01 = vfmaq_f32(a01, v, b1);
+        v = vld1q_f32(x1 + k);             a10 = vfmaq_f32(a10, v, b0); a11 = vfmaq_f32(a11, v, b1);
+        v = vld1q_f32(x2 + k);             a20 = vfmaq_f32(a20, v, b0); a21 = vfmaq_f32(a21, v, b1);
+        v = vld1q_f32(x3 + k);             a30 = vfmaq_f32(a30, v, b0); a31 = vfmaq_f32(a31, v, b1);
+    }
+    float s00 = ks_hsum(a00), s01 = ks_hsum(a01), s10 = ks_hsum(a10), s11 = ks_hsum(a11);
+    float s20 = ks_hsum(a20), s21 = ks_hsum(a21), s30 = ks_hsum(a30), s31 = ks_hsum(a31);
+    for (; k < K; ++k) {
+        s00 = __builtin_fmaf(x0[k], y0[k], s00); s01 = __builtin_fmaf(x0[k], y1[k], s01);
+        s10 = __builtin_fmaf(x1[k], y0[k], s10); s11 = __builtin_fmaf(x1[k], y1[k], s11);
+        s20 = __builtin_fmaf(x2[k], y0[k], s20); s21 = __builtin_fmaf(x2[k], y1[k], s21);
+        s30 = __builtin_fmaf(x3[k], y0[k], s30); s31 = __builtin_fmaf(x3[k], y1[k], s31);
+    }
+    d0[0] = s00; d0[1] = s10; d0[2] = s20; d0[3] = s30;
+    d1[0] = s01; d1[1] = s11; d1[2] = s21; d1[3] = s31;
+}
+static inline float ks_dot1(int K, const float * x, const float * y) {
+    float32x4_t a = vdupq_n_f32(0.0f), b = a;
+    int k = 0;
+    for (; k + 8 <= K; k += 8) {
+        a = vfmaq_f32(a, vld1q_f32(x + k), vld1q_f32(y + k));
+        b = vfmaq_f32(b, vld1q_f32(x + k + 4), vld1q_f32(y + k + 4));
+    }
+    for (; k + 4 <= K; k += 4) a = vfmaq_f32(a, vld1q_f32(x + k), vld1q_f32(y + k));
+    float s = ks_hsum(vaddq_f32(a, b));
+    for (; k < K; ++k) s = __builtin_fmaf(x[k], y[k], s);
+    return s;
+}
+static bool ks_mul_mat_f32_blocked(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    GGML_TENSOR_BINARY_OP_LOCALS
+    if (ne02 != ne12 || ne03 != ne13) return false;
+    if (ne00 < 16 || ne01 < 4) return false;                       // too small to block: exact path
+    if (ne00 > 65536 || ne01 > 65536 || ne11 * ne12 * ne13 > 1048576) return false;
+    const int K = (int)ne00, M = (int)ne01, C = (int)ne11, nmat = (int)(ne12 * ne13);
+    // A block of src0 rows (up to 16 KB) stays in L1 while every src1 column
+    // pair streams past it; walking all rows per column pair instead reloads
+    // src0 from L2 for each pair.
+    int RB = (16384 / (K * 4)) & ~3;
+    if (RB < 4) RB = 4;
+    if (RB > M) RB = (M + 3) & ~3;
+    const int nrb = (M + RB - 1) / RB, items = nmat * nrb;
+    for (int it = params->ith; it < items; it += params->nth) {
+        const int mi = it / nrb, rb0 = (it % nrb) * RB, rb1 = rb0 + RB < M ? rb0 + RB : M;
+        const int i12 = mi % (int)ne12, i13 = mi / (int)ne12;
+        const char * a = (const char *)src0->data + (size_t)i12*nb02 + (size_t)i13*nb03;
+        const char * b = (const char *)src1->data + (size_t)i12*nb12 + (size_t)i13*nb13;
+        char * dd = (char *)dst->data + (size_t)i12*nb2 + (size_t)i13*nb3;
+        for (int c0 = 0; c0 < C; c0 += 2) {
+            const float * y0 = (const float *)(b + (size_t)c0*nb11);
+            float * d0 = (float *)(dd + (size_t)c0*nb1);
+            if (c0 + 1 < C) {
+                const float * y1 = (const float *)(b + (size_t)(c0 + 1)*nb11);
+                float * d1 = (float *)(dd + (size_t)(c0 + 1)*nb1);
+                int r = rb0;
+                for (; r + 4 <= rb1; r += 4) {
+                    const float * x[4];
+                    for (int j = 0; j < 4; ++j) x[j] = (const float *)(a + (size_t)(r + j)*nb01);
+                    ks_gemm_f32_4x2(K, x, y0, y1, d0 + r, d1 + r);
+                }
+                for (; r < rb1; ++r) {
+                    const float * x0 = (const float *)(a + (size_t)r*nb01);
+                    d0[r] = ks_dot1(K, x0, y0); d1[r] = ks_dot1(K, x0, y1);
+                }
+            } else {
+                for (int r = rb0; r < rb1; ++r) d0[r] = ks_dot1(K, (const float *)(a + (size_t)r*nb01), y0);
+            }
+        }
+    }
+    return true;
+}
+#endif
+
+static bool ks_mul_mat_f32_small(const struct ggml_compute_params * params, struct ggml_tensor * dst) {
+    const struct ggml_tensor * src0 = dst->src[0];
+    const struct ggml_tensor * src1 = dst->src[1];
+    if (src0->type != GGML_TYPE_F32 || src1->type != GGML_TYPE_F32 || dst->type != GGML_TYPE_F32) return false;
+    GGML_TENSOR_BINARY_OP_LOCALS
+    if (ne02 != ne12 || ne03 != ne13) return false;                 // no broadcast
