+/// @brief Frames of correction a chunk gets for `abs_error_us`.
+static uint32_t soft_sync_frames(int64_t abs_error_us) {
+    if (abs_error_us < SOFT_SYNC_SCALE_THRESHOLD_US) {
+        return 1;
+    }
+    return static_cast<uint32_t>(std::min<int64_t>(
+        1 + (abs_error_us - SOFT_SYNC_SCALE_THRESHOLD_US) / SOFT_SYNC_US_PER_FRAME,
+        SOFT_SYNC_MAX_FRAMES));
+}
