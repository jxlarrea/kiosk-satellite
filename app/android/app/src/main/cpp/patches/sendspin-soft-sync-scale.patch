+void SyncTask::soft_sync_insert_frames(SyncContext& sync_context, uint32_t count) {
+    // Spreads several inserted frames evenly through the chunk, each the average of its neighbors.
+    // Working from the end keeps the earlier positions valid.
+    const size_t frame_bytes = sync_context.bytes_per_frame;
+    const size_t frames = sync_context.decode_buffer->available() / frame_bytes;
+    if ((count <= 1) || (frames < 2 * (static_cast<size_t>(count) + 1)) ||
+        (sync_context.decode_buffer->free() < count * frame_bytes)) {
+        this->soft_sync_insert_frame(sync_context);
+        return;
+    }
+
+    const uint32_t num_channels = sync_context.current_stream_info.get_channels();
+    const uint32_t bytes_per_sample = sync_context.bytes_per_frame / num_channels;
+    uint8_t* start = sync_context.decode_buffer->get_buffer_start();
+    size_t current = frames;
+    for (uint32_t k = count; k >= 1; --k) {
+        const size_t position = frames * k / (static_cast<size_t>(count) + 1);
+        uint8_t* frame = start + position * frame_bytes;
+        std::memmove(frame + frame_bytes, frame, (current - position) * frame_bytes);
+        for (uint32_t chan = 0; chan < num_channels; ++chan) {
+            const size_t chan_offset =
+                static_cast<size_t>(chan) * static_cast<size_t>(bytes_per_sample);
+            const int32_t before =
+                unpack_audio_sample_to_q31(frame - frame_bytes + chan_offset, bytes_per_sample);
+            const int32_t after =
+                unpack_audio_sample_to_q31(frame + frame_bytes + chan_offset, bytes_per_sample);
+            pack_q31_as_audio_sample(before / 2 + after / 2, frame + chan_offset, bytes_per_sample);
+        }
+        ++current;
+        sync_context.decode_buffer->increase_buffer_length(frame_bytes);
+    }
+}
+
+void SyncTask::soft_sync_drop_frames(SyncContext& sync_context, uint32_t count) {
+    // Spreads several removed frames evenly through the chunk, each blended into the frame before
+    // it. decrease_buffer_length() releases bytes from the front, so the frames ahead of a removed
+    // one slide forward over it. Working from the end keeps the earlier positions valid.
+    const size_t frame_bytes = sync_context.bytes_per_frame;
+    const size_t frames = sync_context.decode_buffer->available() / frame_bytes;
+    if ((count <= 1) || (frames < 2 * (static_cast<size_t>(count) + 1))) {
+        this->soft_sync_drop_frame(sync_context);
+        return;
+    }
+
+    const uint32_t num_channels = sync_context.current_stream_info.get_channels();
+    const uint32_t bytes_per_sample = sync_context.bytes_per_frame / num_channels;
+    for (uint32_t k = count; k >= 1; --k) {
+        const size_t position = frames * k / (static_cast<size_t>(count) + 1);
+        uint8_t* start = sync_context.decode_buffer->get_buffer_start();
+        uint8_t* frame = start + position * frame_bytes;
+        for (uint32_t chan = 0; chan < num_channels; ++chan) {
+            const size_t chan_offset =
+                static_cast<size_t>(chan) * static_cast<size_t>(bytes_per_sample);
+            const int32_t before =
+                unpack_audio_sample_to_q31(frame - frame_bytes + chan_offset, bytes_per_sample);
+            const int32_t removed =
+                unpack_audio_sample_to_q31(frame + chan_offset, bytes_per_sample);
+            pack_q31_as_audio_sample(before / 2 + removed / 2, frame - frame_bytes + chan_offset,
+                                     bytes_per_sample);
+        }
+        std::memmove(start + frame_bytes, start, position * frame_bytes);
+        sync_context.decode_buffer->decrease_buffer_length(frame_bytes);
+    }
+}
