+// ── exp, sigmoid and tanh for the controller ──────────────────────────────
+// Cephes-style expf: n = round(x / ln 2) (the 1.5 * 2^23 rounding trick),
+// r = x - n ln 2 in two parts, a degree-5 polynomial, then 2^n through the
+// exponent bits. About 2 ulp against libm. The scalar and NEON versions do
+// the same operations in the same order (this file builds with
+// -ffp-contract=off and the NEON multiply-adds are unfused), so they agree
+// bit for bit; only the reciprocal differs, where ARMv7 NEON refines an
+// estimate instead of dividing.
+static constexpr float DAF_EXP_LO = -87.3f, DAF_EXP_HI = 88.3f;
+static constexpr float DAF_LOG2E = 1.44269504088896341f, DAF_RND = 12582912.0f;
+static constexpr float DAF_LN2_HI = 0.693359375f, DAF_LN2_LO = -2.12194440e-4f;
+static constexpr float DAF_P0 = 1.9875691500e-4f, DAF_P1 = 1.3981999507e-3f, DAF_P2 = 8.3334519073e-3f,
+                       DAF_P3 = 4.1665795894e-2f, DAF_P4 = 1.6666665459e-1f, DAF_P5 = 5.0000001201e-1f;
+
+static inline float daf_expf(float x) {
+    x = std::min(std::max(x, DAF_EXP_LO), DAF_EXP_HI);
+    const float t = x * DAF_LOG2E + DAF_RND;
+    const float n = t - DAF_RND;
+    float r = x - n * DAF_LN2_HI;
+    r = r - n * DAF_LN2_LO;
+    float p = DAF_P0;
+    p = p * r + DAF_P1; p = p * r + DAF_P2; p = p * r + DAF_P3; p = p * r + DAF_P4; p = p * r + DAF_P5;
+    const float y = p * (r * r) + r + 1.0f;
+    const int32_t e = ((int32_t)n + 127) << 23;
+    float s; std::memcpy(&s, &e, sizeof s);
+    return y * s;
+}
+static inline float daf_sigmoid(float x) { return 1.0f / (1.0f + daf_expf(-x)); }
+static inline float daf_tanh(float x)    { return 2.0f / (1.0f + daf_expf(-2.0f * x)) - 1.0f; }
