diff --git a/ggml/daf_fft.h b/ggml/daf_fft.h
new file mode 100644
index 0000000..28a13c0
--- /dev/null
+++ b/ggml/daf_fft.h
@@ -0,0 +1,107 @@
+#pragma once
+// Real FFT shared by the DAF front-end and the GTCRN STFT (header-only, each
+// translation unit gets its own copies and plan cache).
+#include <cmath>
+#include <map>
+#include <vector>
+#include <algorithm>
+
+// ── real FFT ───────────────────────────────────────────────────────────────
+// An n-point real transform runs as an n/2-point complex FFT of the packed
+// signal (even samples real, odd samples imaginary) plus one split pass.
+// Twiddles come from per-size tables (computed in double, stored as float).
+struct daf_fft_plan {
+    int n = 0;                     // complex size (half the real size)
+    std::vector<int> rev;          // bit reversal
+    std::vector<float> wr, wi;     // exp(-2 pi i k / n), k < n/2
+    std::vector<float> sr, si;     // exp(-2 pi i k / 2n), k <= n (real split)
+};
+
+static const daf_fft_plan& daf_fft_plan_for(int n) {
+    static thread_local std::map<int, daf_fft_plan> plans;
+    daf_fft_plan& p = plans[n];
+    if (p.n == n) return p;
+    p.n = n;
+    int bits = 0; while ((1 << bits) < n) bits++;
+    p.rev.resize(n);
+    for (int i = 0; i < n; i++) {
+        int r = 0; for (int b = 0; b < bits; b++) if (i & (1 << b)) r |= 1 << (bits - 1 - b);
+        p.rev[i] = r;
+    }
+    p.wr.resize(n / 2); p.wi.resize(n / 2);
+    for (int k = 0; k < n / 2; k++) {
+        const double a = -2.0 * M_PI * (double)k / (double)n;
+        p.wr[k] = (float)cos(a); p.wi[k] = (float)sin(a);
+    }
+    p.sr.resize(n + 1); p.si.resize(n + 1);
+    for (int k = 0; k <= n; k++) {
+        const double a = -M_PI * (double)k / (double)n;
+        p.sr[k] = (float)cos(a); p.si[k] = (float)sin(a);
+    }
+    p.sr[0] = 1.0f; p.si[0] = 0.0f; p.sr[n] = -1.0f; p.si[n] = 0.0f;
+    if (n % 2 == 0) { p.sr[n / 2] = 0.0f; p.si[n / 2] = -1.0f; }
+    return p;
+}
+
+// in-place complex FFT (inverse: conjugate twiddles, no scaling)
+static void daf_cfft(const daf_fft_plan& p, float* re, float* im, bool inv) {
+    const int n = p.n;
+    for (int i = 0; i < n; i++) {
+        const int j = p.rev[i];
+        if (i < j) { std::swap(re[i], re[j]); std::swap(im[i], im[j]); }
+    }
+    const float sg = inv ? -1.0f : 1.0f;
+    for (int len = 2, step = n / 2; len <= n; len <<= 1, step >>= 1) {
+        const int h = len / 2;
+        for (int k = 0; k < h; k++) {
+            const float wr = p.wr[(size_t)k * step], wi = sg * p.wi[(size_t)k * step];
+            for (int i = k; i < n; i += len) {
+                const int b = i + h;
+                const float vr = re[b]*wr - im[b]*wi, vi = re[b]*wi + im[b]*wr;
+                re[b] = re[i] - vr; im[b] = im[i] - vi;
+                re[i] += vr;        im[i] += vi;
+            }
+        }
+    }
+}
+
+// rfft of x (n real) -> nb = n/2+1 bins
+static void rfft(const float* x, int n, float* outr, float* outi) {
+    const int h = n / 2;
+    const daf_fft_plan& p = daf_fft_plan_for(h);
+    static thread_local std::vector<float> zr, zi;
+    zr.resize(h); zi.resize(h);
+    for (int m = 0; m < h; m++) { zr[m] = x[2*m]; zi[m] = x[2*m + 1]; }
+    daf_cfft(p, zr.data(), zi.data(), false);
+    for (int k = 0; k <= h; k++) {
+        const int a = k % h, b = (h - k) % h;
+        const float Zr = zr[a], Zi = zi[a], Cr = zr[b], Ci = -zi[b];
+        const float Er = 0.5f * (Zr + Cr), Ei = 0.5f * (Zi + Ci);
+        const float Or = 0.5f * (Zi - Ci), Oi = -0.5f * (Zr - Cr);
+        const float wr = p.sr[k], wi = p.si[k];
+        outr[k] = Er + (Or*wr - Oi*wi);
+        outi[k] = Ei + (Or*wi + Oi*wr);
+    }
+}
+
+// irfft: nb = n/2+1 bins (hermitian) -> n real samples. Like a full complex
+// inverse that keeps only the real part, it ignores Im of bins 0 and n/2.
+static void irfft(const float* br, const float* bi, int n, float* out) {
+    const int h = n / 2;
+    const daf_fft_plan& p = daf_fft_plan_for(h);
+    static thread_local std::vector<float> zr, zi;
+    zr.resize(h); zi.resize(h);
+    for (int k = 0; k < h; k++) {
+        const int c = h - k;
+        const float Xr = br[k], Xi = k == 0 ? 0.0f : bi[k];
+        const float Cr = br[c], Ci = c == h ? 0.0f : -bi[c];
+        const float Er = 0.5f * (Xr + Cr), Ei = 0.5f * (Xi + Ci);
+        const float Dr = 0.5f * (Xr - Cr), Di = 0.5f * (Xi - Ci);
+        const float ur = p.sr[k], ui = -p.si[k];          // exp(+2 pi i k / n)
+        const float Or = Dr*ur - Di*ui, Oi = Dr*ui + Di*ur;
+        zr[k] = Er - Oi; zi[k] = Ei + Or;
+    }
+    daf_cfft(p, zr.data(), zi.data(), true);
+    const float s = 1.0f / (float)h;
+    for (int m = 0; m < h; m++) { out[2*m] = zr[m] * s; out[2*m + 1] = zi[m] * s; }
+}
